.pio_version 0 // only requires PIO version 0

.program uart_tx
.side_set 1 opt

; An 8n1 UART transmit program.
; OUT pin 0 and side-set pin 0 are both mapped to UART TX pin.

    pull                   ; first byte is length to be sent
    set pins, 1 side 1     ; pull our driver ACTIVE here already, making sure line is HIGH
    mov y, osr             ; store length in register y
    out null, 32           ; discard the data in the OSR
byteloop:
    pull       side 1 [7]  ; Assert stop bit, or stall with line in idle state
    set pins, 1       [7]  ; pull dir pin HIGH and wait during second stop bit
    set x, 7   side 0 [7]  ; Preload bit counter, assert start bit for 8 clocks
bitloop:                   ; This loop will run 8 times (8n1 UART)
    out pins, 1            ; Shift 1 bit from OSR to the first OUT pin
    jmp x-- bitloop   [6]  ; Each loop iteration is 8 cycles.
    jmp y-- byteloop       ; ... as long as we shall send bytes
    set pins, 1 side 1 [7] ; leave LINE and DIR HIGH during final stop bits
    set pins, 1 side 1 [7] ; ... some more
    set pins, 0 side 1     ; switch OFF our DRIVER


% c-sdk {
#include "hardware/clocks.h"

static inline void uart_tx_program_init(PIO pio, uint sm, uint offset, uint pin_tx, uint pin_dir, uint baud) {
    // Tell PIO to initially drive output-high on the selected pin, then map PIO
    // onto that pin with the IO muxes.
    pio_sm_set_pins_with_mask64(pio, sm, 1ull << pin_tx, 1ull << pin_tx);
    pio_sm_set_pindirs_with_mask64(pio, sm, 1ull << pin_tx, 1ull << pin_tx);
    pio_gpio_init(pio, pin_tx);

    // Drive the DIR pin LOW
    pio_sm_set_pins_with_mask64(pio, sm, 0ull << pin_dir, 1ull << pin_dir);
    pio_sm_set_pindirs_with_mask64(pio, sm, 1ull << pin_dir, 1ull << pin_dir);
    pio_gpio_init(pio, pin_dir);

    pio_sm_config c = uart_tx_program_get_default_config(offset);

    // OUT shifts to right, no autopull
    sm_config_set_out_shift(&c, true, false, 32);

    // We are mapping both OUT and side-set to the same pin, because sometimes
    // we need to assert user data onto the pin (with OUT) and sometimes
    // assert constant values (start/stop bit)
    sm_config_set_out_pins(&c, pin_tx, 1);
    sm_config_set_set_pins(&c, pin_dir, 1);
    sm_config_set_sideset_pins(&c, pin_tx);

    // We only need TX, so get an 8-deep FIFO!
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    // SM transmits 1 bit per 8 execution cycles.
    float div = (float)clock_get_hz(clk_sys) / (8 * baud);
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

static inline void uart_tx_program_putc(PIO pio, uint sm, char c) {
    pio_sm_put_blocking(pio, sm, (uint32_t)c);
}

%}
